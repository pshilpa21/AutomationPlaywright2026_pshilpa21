# Juice Shop target. Compose publishes this port on localhost only.
JUICE_SHOP_PORT=3001
BASE_URL=http://127.0.0.1:3001

# Optional AI provider using an OpenAI-compatible Chat Completions endpoint.
# Leave unset until you configure a provider. Never commit API keys.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=60000
